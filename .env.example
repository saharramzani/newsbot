# --- Required ---
TELEGRAM_BOT_TOKEN=
# LLM: gemini (free tier) or anthropic (paid)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=   # only if LLM_PROVIDER=anthropic
ELEVENLABS_API_KEY=
# comma-separated Telegram numeric user ids allowed to use the bot (REQUIRED; anyone else is ignored)
ALLOWED_USER_IDS=

# --- Models ---
SCOUT_MODEL=claude-opus-5-5
WRITER_MODEL=claude-opus-5-5

# --- ElevenLabs ---
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# --- Whisper (runs locally) ---
WHISPER_MODEL=small

# --- Video ---
LOGO_PATH=assets/logo.png
SUBTITLE_FONT=Vazirmatn
NEWS_WINDOW_HOURS=12

# --- Optional: folder containing ffmpeg.exe / ffprobe.exe, if it is not found automatically ---
FFMPEG_DIR=

# --- Free fallback voice when ElevenLabs credits run out ---
# edge = Microsoft Edge TTS (free, no key); none = stop with an error instead
FALLBACK_TTS=edge
# fa-IR-FaridNeural (male) or fa-IR-DilaraNeural (female)
EDGE_VOICE=fa-IR-FaridNeural
EDGE_RATE=+5%

# --- Bulletin (/bulletin) ---
BULLETIN_HOURS=24
# font used in the Word file (must be installed on the computer that opens it)
BULLETIN_FONT=B Nazanin
# Gemini requests per minute the bot allows itself (free tier ~10; raise it on a paid plan)
GEMINI_RPM=9
