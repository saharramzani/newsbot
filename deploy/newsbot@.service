[Unit]
Description=newsbot Telegram bot (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=newsbot
WorkingDirectory=/opt/newsbot
# token, BOT_MODE, BOT_BRAND, WORK_DIR of this bot; everything else comes from /opt/newsbot/.env
EnvironmentFile=/opt/newsbot/bots/%i.env
ExecStart=/opt/newsbot/.venv/bin/python bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
